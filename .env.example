BOT_TOKEN=
ADMIN_IDS=

# Пароль для сервиса postgres в docker-compose.yml - должен совпадать с паролем в DATABASE_URL ниже
POSTGRES_PASSWORD=
DATABASE_URL=

REDIS_URL=

# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# True в проде (сайт под HTTPS), False только для локальной разработки по HTTP
SESSION_HTTPS_ONLY=True

YOOMONEY_RECEIVER=
YOOMONEY_SECRET=

REMNAWAVE_URL=
REMNAWAVE_TOKEN=
REMNAWAVE_SECRET_KEY=


SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

WEBAPP_URL=

# Пустая строка здесь ломает старт приложения (не парсится как число) - если не
# нужно менять время жизни веб-сессии, оставьте как есть (24 часа)
SESSION_MAX_AGE=86400

# Часовой пояс для отображения дат/времени пользователю и админу (имя из базы IANA).
# В БД всё хранится в UTC независимо от этой настройки - меняется только вывод.
# Примеры: Europe/Moscow, Asia/Yekaterinburg, Asia/Novosibirsk. По умолчанию UTC.
TIMEZONE=Asia/Yekaterinburg

# Опционально: уведомления админам (оплаты/тикеты/сбои планировщика/бэкапы) -
# вместо личных сообщений каждому из ADMIN_IDS одним сообщением в Telegram-
# группу с топиками. Если оставить пустым, всё продолжает работать как раньше.
# Как настроить - см. README "Уведомления в группу с топиками".
ADMIN_GROUP_CHAT_ID=
ADMIN_TOPIC_PAYMENTS=
ADMIN_TOPIC_SUPPORT=
ADMIN_TOPIC_SYSTEM=
ADMIN_TOPIC_BACKUPS=